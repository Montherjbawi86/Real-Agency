<div class="auth-wrap">
  <div class="auth-card">
    <h2 class="auth-title">إنشاء حساب جديد</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :full_name, "الاسم الكامل", class: "auth-label" %>
        <%= f.text_field :full_name, autofocus: true, class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :phone, "رقم الهاتف", class: "auth-label" %>
        <%= f.telephone_field :phone, placeholder: "09xxxxxxxx", class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :email, "البريد الإلكتروني", class: "auth-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :role, "نوع الحساب", class: "auth-label" %>
        <%= f.select :role,
            [["مشترٍ (أبحث عن عقار أو سيارة)", "buyer"],
             ["وكيل عقارات", "property_agent"],
             ["وكيل سيارات", "car_agent"]],
            {}, class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "كلمة المرور", class: "auth-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-black mt-1">(الحد الأدنى <%= @minimum_password_length %> أحرف)</p>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "تأكيد كلمة المرور", class: "auth-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
      </div>

      <%= f.submit "تسجيل", class: "btn btn-primary btn-block btn-lg" %>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
