<div class="auth-wrap">
  <div class="auth-card">
    <h2 class="auth-title">تعديل الحساب</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :full_name, "الاسم الكامل", class: "auth-label" %>
        <%= f.text_field :full_name, class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :phone, "رقم الهاتف", class: "auth-label" %>
        <%= f.telephone_field :phone, class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :email, "البريد الإلكتروني", class: "auth-label" %>
        <%= f.email_field :email, class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "كلمة مرور جديدة", class: "auth-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
        <p class="text-xs text-black mt-1">اتركه فارغاً إذا لا تريد تغييره</p>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "تأكيد كلمة المرور", class: "auth-label" %>
        <%= f.password_field :password_confirmation, class: "input" %>
      </div>

      <div class="auth-field">
        <%= f.label :current_password, "كلمة المرور الحالية", class: "auth-label" %>
        <%= f.password_field :current_password, class: "input" %>
      </div>

      <%= f.submit "تحديث", class: "btn btn-primary btn-block btn-lg" %>
    <% end %>

    <div class="mt-6 pt-4 border-t text-center">
      <%= button_to "حذف حسابي", registration_path(resource_name),
          method: :delete,
          data: { turbo_confirm: "متأكد؟ لا يمكن التراجع." },
          class: "btn btn-danger btn-sm" %>
    </div>
  </div>
</div>
