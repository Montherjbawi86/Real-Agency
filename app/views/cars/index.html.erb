<div dir="rtl" class="container-page">
  <div class="page-header">
    <div>
      <h1 class="page-title">🚗 السيارات المتاحة</h1>
      <p class="page-subtitle">سيارات جديدة ومستعملة من وكلاء موثوقين</p>
    </div>
    <% if user_signed_in? && current_user.car_agent? %>
      <%= link_to "➕ أضف سيارة", new_car_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="filter-card">
    <%= form_with url: cars_path, method: :get, class: "space-y-4" do %>
      <div>
        <%= text_field_tag :q, params[:q], placeholder: "🔍 بحث بالموديل أو الماركة أو العنوان", class: "input" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
        <%= select_tag :brand,
            options_for_select(@brands || [], params[:brand]),
            include_blank: "🏷️ كل الماركات", class: "input" %>

        <%= select_tag :city_id,
            options_from_collection_for_select(@cities, :id, :name_ar, params[:city_id]),
            include_blank: "🏙️ كل المدن", class: "input" %>

        <%= select_tag :body_type,
            options_for_select([
              ["🚗 سيدان","sedan"],["🚙 دفع رباعي","suv"],["🚕 هاتشباك","hatchback"],
              ["🛻 بيك أب","pickup"],["🚐 فان","van"],["🏎️ كوبيه","coupe"],
              ["🚘 مكشوفة","convertible"],["🚖 ستيشن","wagon"]
            ], params[:body_type]),
            include_blank: "🚗 كل الأنواع", class: "input" %>

        <%= select_tag :sort,
            options_for_select([
              ["الأحدث أولاً", "newest"],
              ["السعر: الأقل → الأعلى", "price_asc"],
              ["السعر: الأعلى → الأقل", "price_desc"],
              ["السنة: الأحدث", "year_desc"],
              ["المسافة: الأقل", "mileage_asc"]
            ], params[:sort]),
            class: "input" %>
      </div>

      <details class="border border-gray-200 rounded-lg p-3">
        <summary class="cursor-pointer font-bold text-black">⚙️ فلاتر متقدمة</summary>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3">
          <div>
            <label class="text-xs font-semibold text-black">⛽ الوقود</label>
            <%= select_tag :fuel_type,
                options_for_select([["بنزين","petrol"],["ديزل","diesel"],["هجين","hybrid"],["كهربائي","electric"],["غاز","gas"]], params[:fuel_type]),
                include_blank: "الكل", class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">⚙️ ناقل الحركة</label>
            <%= select_tag :transmission,
                options_for_select([["عادي","manual"],["أوتوماتيك","automatic"]], params[:transmission]),
                include_blank: "الكل", class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">🔧 الحالة</label>
            <%= select_tag :condition,
                options_for_select([["جديد","new_car"],["مستعمل","used"],["معتمد","certified"]], params[:condition]),
                include_blank: "الكل", class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">💰 السعر من</label>
            <%= number_field_tag :min_price, params[:min_price], class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">💰 السعر إلى</label>
            <%= number_field_tag :max_price, params[:max_price], class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">💱 العملة</label>
            <%= select_tag :currency, options_for_select([["ل.س","SYP"],["$","USD"]], params[:currency]),
                include_blank: "الكل", class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">📅 السنة من</label>
            <%= number_field_tag :min_year, params[:min_year], class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">📅 السنة إلى</label>
            <%= number_field_tag :max_year, params[:max_year], class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">🛣️ أقصى مسافة (كم)</label>
            <%= number_field_tag :max_mileage, params[:max_mileage], class: "input" %>
          </div>
        </div>
      </details>

      <div class="flex gap-2">
        <%= submit_tag "🔍 بحث", class: "btn btn-primary" %>
        <%= link_to "🔄 إعادة تعيين", cars_path, class: "btn btn-gray" %>
      </div>
    <% end %>
  </div>

  <p class="text-sm text-black mb-3">
    النتائج: <strong><%= @cars.count %></strong> سيارة
  </p>

  <% if @cars.any? %>
    <div class="listings-grid">
      <% @cars.each_with_index do |c, i| %>
        <div class="listing-card animate-fade-in" style="animation-delay:<%= i*40 %>ms;">
          <div class="listing-image-wrap">
            <% if c.cover_image.attached? %>
              <%= image_tag c.cover_image, class: "listing-image" %>
            <% else %>
              <div class="listing-image-placeholder">🚗</div>
            <% end %>
            <div class="listing-badges-tr">
              <span class="badge <%= c.new_car? ? 'badge-green' : (c.certified? ? 'badge-blue' : 'badge-yellow') %>">
                <%= c.condition_ar %>
              </span>
              <span class="badge badge-gray"><%= c.body_type_ar %></span>
            </div>
            <div class="listing-price-badge">
              <span class="listing-price-value"><%= number_with_precision(c.price, precision: 0, delimiter: ",") %></span>
              <span class="listing-price-currency"><%= c.currency %></span>
            </div>
          </div>
          <div class="listing-body">
            <h3 class="listing-title"><%= link_to c.title, car_path(c) %></h3>
            <p class="listing-sub"><%= c.brand %> <%= c.car_model %> — <%= c.year %></p>
            <p class="listing-sub">📍 <%= c.city.name_ar %></p>
            <div class="listing-features">
              <span>🛣️ <%= number_with_delimiter(c.mileage) %> كم</span>
              <span>⛽ <%= c.fuel_type_ar %></span>
              <span>⚙️ <%= c.transmission_ar %></span>
            </div>
            <div class="listing-footer">
              <%= link_to "التفاصيل ←", car_path(c), class: "btn btn-outline btn-sm" %>
              <span class="text-xs text-black"><%= time_ago_in_words(c.created_at) %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-icon">🔍</div>
      <h3 class="empty-title">لا توجد سيارات متاحة</h3>
      <p class="empty-sub">جرب تغيير الفلاتر</p>
    </div>
  <% end %>
</div>
