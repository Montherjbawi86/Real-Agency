<%= form_with model: [:dashboard, @customer], class: "bg-white p-6 rounded-xl shadow max-w-2xl space-y-4" do |f| %>
  <% if @customer.errors.any? %>
    <div class="bg-red-100 p-3 rounded">
      <% @customer.errors.full_messages.each do |m| %><p>• <%= m %></p><% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :full_name, "الاسم الكامل", class: "block mb-1 font-semibold" %>
      <%= f.text_field :full_name, class: "input", required: true %>
    </div>
    <div>
      <%= f.label :phone, "رقم الهاتف", class: "block mb-1 font-semibold" %>
      <%= f.text_field :phone, class: "input", required: true, placeholder: "09xxxxxxxx" %>
    </div>
  </div>

  <div>
    <%= f.label :national_id, "الرقم الوطني", class: "block mb-1 font-semibold" %>
    <%= f.text_field :national_id, class: "input" %>
  </div>

  <div>
    <%= f.label :address, "العنوان", class: "block mb-1 font-semibold" %>
    <%= f.text_field :address, class: "input" %>
  </div>

  <div>
    <%= f.label :notes, "ملاحظات", class: "block mb-1 font-semibold" %>
    <%= f.text_area :notes, rows: 3, class: "input" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit "حفظ", class: "btn btn-primary btn-lg" %>
    <%= link_to "إلغاء", dashboard_customers_path, class: "btn btn-gray btn-lg" %>
  </div>
<% end %>
