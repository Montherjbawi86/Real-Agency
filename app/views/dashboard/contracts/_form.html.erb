<%
  prices = if current_user.car_agent?
    current_user.cars.pluck(:id, :price).to_h
  else
    current_user.properties.pluck(:id, :price).to_h
  end
%>

<%= form_with model: [:dashboard, @contract],
    data: {
      controller: "contract-autofill",
      "contract-autofill-prices-value": prices.to_json
    },
    class: "bg-white p-6 rounded-xl shadow max-w-3xl space-y-4" do |f| %>

  <% if @contract.errors.any? %>
    <div class="bg-red-100 p-3 rounded">
      <% @contract.errors.full_messages.each do |m| %><p>• <%= m %></p><% end %>
    </div>
  <% end %>

  <% if current_user.car_agent? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :car_id, "🚗 السيارة", class: "block mb-1 font-semibold" %>
        <%= f.collection_select :car_id,
            current_user.cars.order(created_at: :desc),
            :id, :select_label,
            { include_blank: "— اختر سيارة —" },
            class: "input",
            data: { "contract-autofill-target": "subject", action: "change->contract-autofill#fill" } %>
      </div>
      <div>
        <%= f.label :customer_id, "🧑‍💼 العميل", class: "block mb-1 font-semibold" %>
        <%= f.collection_select :customer_id,
            current_user.customers.order(:full_name),
            :id, :select_label,
            { include_blank: "— اختر عميل —" },
            class: "input" %>
        <p class="text-xs mt-1">
          <%= link_to "➕ إضافة عميل جديد", new_dashboard_customer_path, class: "text-blue-600 hover:underline", target: "_blank" %>
        </p>
      </div>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :property_id, "🏘️ العقار", class: "block mb-1 font-semibold" %>
        <%= f.collection_select :property_id,
            current_user.properties.order(created_at: :desc),
            :id, ->(p) { "#{p.title} — #{number_with_delimiter(p.price)} #{p.currency}" },
            { include_blank: "— اختر عقار —" },
            class: "input",
            data: { "contract-autofill-target": "subject", action: "change->contract-autofill#fill" } %>
      </div>
      <div>
        <%= f.label :tenant_id, "👤 المستأجر", class: "block mb-1 font-semibold" %>
        <%= f.collection_select :tenant_id,
            current_user.tenants.order(:full_name),
            :id, ->(t) { "#{t.full_name} — #{t.phone}" },
            { include_blank: "— اختر مستأجر —" },
            class: "input" %>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :kind, "📋 نوع العقد", class: "block mb-1 font-semibold" %>
      <%= f.select :kind,
          [["🔑 إيجار","rent"],["💰 بيع","sale"]],
          {},
          class: "input",
          data: { "contract-autofill-target": "kind", action: "change->contract-autofill#toggleRental" } %>
    </div>
    <div>
      <%= f.label :status, "📌 حالة العقد", class: "block mb-1 font-semibold" %>
      <%= f.select :status,
          [["مسودة","draft"],["نشط","active"],["مكتمل","completed"],["منتهي","expired"],["ملغى","terminated"]],
          {}, class: "input" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :start_date, "📅 من تاريخ", class: "block mb-1 font-semibold" %>
      <%= f.date_field :start_date,
          class: "input",
          value: (@contract.start_date || Date.current),
          data: { "contract-autofill-target": "start", action: "change->contract-autofill#calcRental" } %>
    </div>
    <div>
      <%= f.label :end_date, "📅 إلى تاريخ", class: "block mb-1 font-semibold" %>
      <%= f.date_field :end_date,
          class: "input",
          value: (@contract.end_date || 1.month.from_now.to_date),
          data: { "contract-autofill-target": "end", action: "change->contract-autofill#calcRental" } %>
    </div>
  </div>

  <div data-contract-autofill-target="rentalBlock"
       style="<%= 'display:none;' unless @contract.car_id.present? && @contract.rent? %>"
       class="bg-amber-50 border border-amber-200 rounded-lg p-4 space-y-3">
    <h3 class="font-bold text-amber-900">🚗 تفاصيل الإيجار اليومي</h3>
    <div class="grid grid-cols-3 gap-3">
      <div>
        <%= f.label :daily_rate, "💵 السعر اليومي", class: "block mb-1 font-semibold text-sm" %>
        <%= f.number_field :daily_rate,
            class: "input", step: "0.01", min: "0", placeholder: "0",
            value: @contract.daily_rate,
            data: { "contract-autofill-target": "dailyRate", action: "input->contract-autofill#calcRental" } %>
      </div>
      <div>
        <%= f.label :days, "📅 عدد الأيام", class: "block mb-1 font-semibold text-sm" %>
        <%= f.number_field :days, class: "input", readonly: true, value: @contract.days,
            data: { "contract-autofill-target": "days" } %>
      </div>
      <div>
        <%= f.label :amount, "💰 الإجمالي", class: "block mb-1 font-semibold text-sm" %>
        <%= f.number_field :amount, class: "input font-bold", readonly: true, value: @contract.amount,
            data: { "contract-autofill-target": "amount" } %>
      </div>
    </div>
    <p class="text-sm text-amber-800">
      💡 الأيام تُحسب تلقائياً، والسعر الإجمالي = الأيام × السعر اليومي
    </p>
  </div>

  <div data-contract-autofill-target="saleBlock"
       class="space-y-3 <%= 'hidden' if @contract.car_id.present? && @contract.rent? %>">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :amount, "💰 المبلغ الإجمالي", class: "block mb-1 font-semibold" %>
        <%= f.number_field :amount,
            class: "input", step: "0.01", min: "0.01",
            required: !(@contract.car_id.present? && @contract.rent?),
            placeholder: "0.00", value: @contract.amount,
            data: { "contract-autofill-target": "saleAmount", action: "input->contract-autofill#updateRemaining" } %>
        <p class="text-xs text-black mt-1">
          💡 يُقترح تلقائياً من سعر العقار/السيارة، ويمكن تعديله
        </p>
      </div>
      <div>
        <%= f.label :currency, "💱 العملة", class: "block mb-1 font-semibold" %>
        <%= f.select :currency, [["ل.س","SYP"],["$ USD","USD"]], {}, class: "input" %>
      </div>
    </div>
  </div>

  <% if current_user.car_agent? %>
    <div data-contract-autofill-target="odometerBlock"
         style="<%= 'display:none;' unless @contract.car_id.present? %>"
         class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :start_odometer, "📏 عداد الاستلام (كم)", class: "block mb-1 font-semibold text-sm" %>
        <%= f.number_field :start_odometer, class: "input", value: @contract.start_odometer %>
      </div>
      <div>
        <%= f.label :end_odometer, "📏 عداد التسليم (كم)", class: "block mb-1 font-semibold text-sm" %>
        <%= f.number_field :end_odometer, class: "input", value: @contract.end_odometer %>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :notes, "📝 ملاحظات", class: "block mb-1 font-semibold" %>
    <%= f.text_area :notes, rows: 3, class: "input", placeholder: "أي شروط أو تفاصيل إضافية..." %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit "💾 حفظ العقد", class: "btn btn-primary btn-lg" %>
    <%= link_to "إلغاء", dashboard_contracts_path, class: "btn btn-gray btn-lg" %>
  </div>
<% end %>
