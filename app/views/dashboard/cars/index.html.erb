<div dir="rtl" class="animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">🚗 سياراتي</h1>
      <p class="page-subtitle">إدارة أسطول السيارات</p>
    </div>
    <%= link_to "➕ إضافة سيارة", new_car_path, class: "btn btn-primary" %>
  </div>

  <!-- Filter tabs -->
  <div class="filter-tabs">
    <%= link_to dashboard_cars_path,
        class: "filter-tab #{'active' if params[:status].blank?}" do %>
      الكل <span class="filter-count"><%= @counts[:all] %></span>
    <% end %>
    <%= link_to dashboard_cars_path(status: "draft"),
        class: "filter-tab #{'active' if params[:status] == 'draft'}" do %>
      📝 مسودة <span class="filter-count"><%= @counts[:draft] %></span>
    <% end %>
    <%= link_to dashboard_cars_path(status: "published"),
        class: "filter-tab #{'active' if params[:status] == 'published'}" do %>
      ✅ متاحة <span class="filter-count"><%= @counts[:published] %></span>
    <% end %>
    <%= link_to dashboard_cars_path(status: "rented"),
        class: "filter-tab #{'active' if params[:status] == 'rented'}" do %>
      🔑 مؤجّرة <span class="filter-count"><%= @counts[:rented] %></span>
    <% end %>
    <%= link_to dashboard_cars_path(status: "sold"),
        class: "filter-tab #{'active' if params[:status] == 'sold'}" do %>
      💰 مُباعة <span class="filter-count"><%= @counts[:sold] %></span>
    <% end %>
  </div>

  <!-- Search -->
  <div class="filter-card">
    <%= form_with url: dashboard_cars_path, method: :get, class: "filter-grid" do %>
      <%= hidden_field_tag :status, params[:status] if params[:status].present? %>

      <%= text_field_tag :q, params[:q],
          placeholder: "🔍 بحث بالماركة أو الموديل",
          class: "input", style: "grid-column: span 2;" %>

      <%= select_tag :sort,
          options_for_select([
            ["الأحدث أولاً", "newest"],
            ["الأقدم أولاً", "oldest"],
            ["السعر (الأعلى)", "price_high"],
            ["السعر (الأدنى)", "price_low"]
          ], params[:sort]),
          class: "input" %>

      <div class="flex gap-2">
        <%= submit_tag "🔍 بحث", class: "btn btn-success" %>
        <% if params[:q].present? || params[:sort].present? %>
          <%= link_to "مسح", dashboard_cars_path, class: "btn btn-gray" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @cars.any? %>
    <div class="card overflow-hidden">
      <table class="table-clean">
        <thead>
          <tr>
            <th>#</th><th>السيارة</th><th>السنة</th><th>المسافة</th>
            <th>السعر</th><th>المدفوع</th><th>المتبقي</th><th>الحالة</th><th>إجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% @cars.each do |c| %>
            <tr>
              <td>#<%= c.id %></td>
              <td>
                <div class="font-semibold"><%= c.brand %> <%= c.car_model %></div>
                <div class="text-xs text-black"><%= c.title.truncate(40) %></div>
              </td>
              <td><%= c.year %></td>
              <td><%= number_with_delimiter(c.mileage) %> كم</td>
              <td class="font-bold"><%= number_with_precision(c.price, precision: 0, delimiter: ",") %> <%= c.currency %></td>
              <td class="font-bold text-green-700"><%= number_with_precision(c.total_paid, precision: 0, delimiter: ",") %></td>
              <td class="font-bold text-red-700"><%= number_with_precision(c.total_remaining, precision: 0, delimiter: ",") %></td>
              <td><span class="badge badge-gray"><%= c.status_ar %></span></td>
              <td>
                <div class="flex flex-wrap gap-1">
                  <%= link_to "عرض", car_path(c), class: "btn btn-primary btn-sm" %>
                    <button type="button"
                            class="btn btn-success btn-sm"
                            onclick="event.stopPropagation(); document.getElementById('share-modal-<%= c.id %>').style.display='block';">
                      📤 شارك
                    </button>
                  <%= link_to "تعديل", edit_car_path(c), class: "btn btn-warning btn-sm" %>
                  <%= button_to "حذف", c, method: :delete, data: { turbo_confirm: "متأكد؟" }, class: "btn btn-danger btn-sm" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% @cars.each do |c| %>
      <%= render "shared/share_modal", subject: c, host: request.host_with_port %>
    <% end %>
    <p class="text-sm text-black mt-3">عرض <%= @cars.size %> سيارة</p>
  <% else %>
    <div class="empty-state">
      <div class="empty-icon">🚗</div>
      <h3 class="empty-title">لا توجد سيارات</h3>
      <div class="mt-4">
        <%= link_to "➕ إضافة سيارة", new_car_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
