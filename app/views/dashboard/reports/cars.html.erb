<div dir="rtl" class="text-black animate-fade-in">

  <!-- Header -->
  <div class="flex justify-between items-start flex-wrap gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-extrabold bg-gradient-to-l from-cyan-600 to-blue-700 bg-clip-text text-transparent">
        📈 تقارير السيارات
      </h1>
      <p class="text-gray-500 mt-1 text-sm">
        نظرة شاملة على أسطولك — آخر تحديث <%= Time.current.strftime("%Y-%m-%d %H:%M") %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "➕ إضافة سيارة", new_car_path, class: "btn btn-primary" %>
      <%= link_to "🚗 كل السيارات", cars_path, class: "btn btn-outline" %>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
    <div class="bg-white rounded-2xl p-5 border-r-4 border-blue-600 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">📦</div>
        <div>
          <p class="text-xs font-bold text-gray-500 uppercase">الإجمالي</p>
          <p class="text-3xl font-extrabold text-gray-900"><%= @total_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 border-r-4 border-emerald-600 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center text-2xl">✅</div>
        <div>
          <p class="text-xs font-bold text-gray-500 uppercase">منشور</p>
          <p class="text-3xl font-extrabold text-emerald-700"><%= @published_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 border-r-4 border-violet-600 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-violet-100 flex items-center justify-center text-2xl">🔑</div>
        <div>
          <p class="text-xs font-bold text-gray-500 uppercase">مؤجّر</p>
          <p class="text-3xl font-extrabold text-violet-700"><%= @rented_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 border-r-4 border-cyan-600 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-cyan-100 flex items-center justify-center text-2xl">💰</div>
        <div>
          <p class="text-xs font-bold text-gray-500 uppercase">مُباع</p>
          <p class="text-3xl font-extrabold text-cyan-700"><%= @sold_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 border-r-4 border-amber-500 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center text-2xl">📝</div>
        <div>
          <p class="text-xs font-bold text-gray-500 uppercase">مسودة</p>
          <p class="text-3xl font-extrabold text-amber-700"><%= @draft_count %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Financial -->
  <h2 class="text-2xl font-bold mb-4 flex items-center gap-3">
    <span class="inline-block w-1 h-6 bg-gradient-to-b from-cyan-600 to-blue-700 rounded-full"></span>
    💵 الملخص المالي
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="rounded-2xl p-6 border-r-4 border-emerald-500 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all"
         style="background:linear-gradient(135deg,#ffffff,#ecfdf5);">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xl">✅</span>
        <span class="text-sm font-bold text-gray-500 uppercase">المدفوع (ل.س)</span>
      </div>
      <p class="text-3xl font-extrabold text-emerald-700">
        <%= number_with_precision(@total_paid_syp.to_f, precision: 0, delimiter: ",") %>
      </p>
      <% if @total_paid_usd.to_f > 0 %>
        <p class="text-sm font-semibold text-gray-600 mt-2">
          + <%= number_with_precision(@total_paid_usd.to_f, precision: 0, delimiter: ",") %> $
        </p>
      <% end %>
    </div>

    <div class="rounded-2xl p-6 border-r-4 border-red-500 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all"
         style="background:linear-gradient(135deg,#ffffff,#fef2f2);">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xl">⚠️</span>
        <span class="text-sm font-bold text-gray-500 uppercase">المتبقي (ل.س)</span>
      </div>
      <p class="text-3xl font-extrabold text-red-700">
        <%= number_with_precision(@total_remaining_syp.to_f, precision: 0, delimiter: ",") %>
      </p>
      <% if @total_remaining_usd.to_f > 0 %>
        <p class="text-sm font-semibold text-gray-600 mt-2">
          + <%= number_with_precision(@total_remaining_usd.to_f, precision: 0, delimiter: ",") %> $
        </p>
      <% end %>
    </div>

    <div class="rounded-2xl p-6 border-r-4 border-amber-500 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all"
         style="background:linear-gradient(135deg,#ffffff,#fffbeb);">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xl">📄</span>
        <span class="text-sm font-bold text-gray-500 uppercase">إجمالي العقود (ل.س)</span>
      </div>
      <p class="text-3xl font-extrabold text-amber-700">
        <%= number_with_precision(@total_contract_syp.to_f, precision: 0, delimiter: ",") %>
      </p>
      <% if @total_contract_usd.to_f > 0 %>
        <p class="text-sm font-semibold text-gray-600 mt-2">
          + <%= number_with_precision(@total_contract_usd.to_f, precision: 0, delimiter: ",") %> $
        </p>
      <% end %>
    </div>
  </div>

  <!-- Breakdown -->
  <h2 class="text-2xl font-bold mb-4 flex items-center gap-3">
    <span class="inline-block w-1 h-6 bg-gradient-to-b from-cyan-600 to-blue-700 rounded-full"></span>
    📊 التفاصيل
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <!-- By Status -->
    <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-lg transition-all">
      <h3 class="text-lg font-bold text-gray-800 mb-4 pb-3 border-b border-gray-100 flex items-center gap-2">
        <span>🚗</span> حسب الحالة
      </h3>
      <% total = @by_status.values.sum.nonzero? || 1 %>
      <% @by_status.each do |status, count| %>
        <%
          pct = (count.to_f / total * 100).round
          labels = { "draft" => "مسودة", "published" => "منشور", "rented" => "مؤجّر", "sold" => "مُباع" }
          colors = { "draft" => "#9ca3af", "published" => "#059669", "rented" => "#7c3aed", "sold" => "#0891b2" }
        %>
        <div class="mb-4">
          <div class="flex justify-between items-center mb-1 text-sm">
            <span class="font-semibold text-gray-700"><%= labels[status] %></span>
            <span class="font-bold text-gray-900"><%= count %> <span class="text-xs">(<%= pct %>%)</span></span>
          </div>
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all duration-500"
                 style="width:<%= pct %>%; background:<%= colors[status] %>;"></div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- By Brand -->
    <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-lg transition-all">
      <h3 class="text-lg font-bold text-gray-800 mb-4 pb-3 border-b border-gray-100 flex items-center gap-2">
        <span>🏷️</span> حسب الماركة
      </h3>
      <% brand_total = @by_brand.values.sum.nonzero? || 1 %>
      <% @by_brand.sort_by { |_, c| -c }.first(8).each do |brand, count| %>
        <% pct = (count.to_f / brand_total * 100).round %>
        <div class="mb-4">
          <div class="flex justify-between items-center mb-1 text-sm">
            <span class="font-semibold text-gray-700"><%= brand %></span>
            <span class="font-bold text-gray-900"><%= count %></span>
          </div>
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full bg-blue-600 transition-all duration-500"
                 style="width:<%= pct %>%;"></div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Values -->
    <div class="rounded-2xl p-6 border border-cyan-100 shadow-sm hover:shadow-lg transition-all"
         style="background:linear-gradient(135deg,#ffffff,#ecfeff);">
      <h3 class="text-lg font-bold text-gray-800 mb-4 pb-3 border-b border-cyan-100 flex items-center gap-2">
        <span>💵</span> القيمة والمتوسطات
      </h3>

      <div class="py-4 border-b border-dashed border-gray-200 text-center">
        <p class="text-xs font-bold text-gray-500 uppercase mb-2">إجمالي قيمة السيارات</p>
        <p class="text-3xl font-extrabold text-cyan-700">
          <%= number_with_precision(@total_value_syp.to_f, precision: 0, delimiter: ",") %>
          <span class="text-sm text-gray-500">ل.س</span>
        </p>
        <% if @total_value_usd.to_f > 0 %>
          <p class="text-xl font-bold text-emerald-700 mt-1">
            <%= number_with_precision(@total_value_usd.to_f, precision: 0, delimiter: ",") %>
            <span class="text-sm text-gray-500">$</span>
          </p>
        <% end %>
      </div>

      <div class="flex justify-between items-center py-3">
        <span class="font-semibold text-gray-600">📏 متوسط المسافة</span>
        <span class="font-extrabold text-gray-900">
          <%= number_with_delimiter(@avg_mileage.to_f.round(0)) %> كم
        </span>
      </div>
    </div>
  </div>

  <!-- Recent -->
  <h2 class="text-2xl font-bold mb-4 flex items-center gap-3">
    <span class="inline-block w-1 h-6 bg-gradient-to-b from-cyan-600 to-blue-700 rounded-full"></span>
    🆕 آخر 10 سيارات
  </h2>

  <% if @recent.any? %>
    <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="text-right p-4 text-xs font-bold text-gray-600 uppercase tracking-wider">السيارة</th>
            <th class="text-right p-4 text-xs font-bold text-gray-600 uppercase tracking-wider">الماركة</th>
            <th class="text-right p-4 text-xs font-bold text-gray-600 uppercase tracking-wider">السنة</th>
            <th class="text-right p-4 text-xs font-bold text-gray-600 uppercase tracking-wider">السعر</th>
            <th class="text-right p-4 text-xs font-bold text-gray-600 uppercase tracking-wider">الحالة</th>
            <th class="text-right p-4"></th>
          </tr>
        </thead>
        <tbody>
          <% @recent.each do |c| %>
            <tr class="border-t border-gray-100 hover:bg-cyan-50 transition-colors">
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <% if c.cover_image.attached? %>
                    <%= image_tag c.cover_image, class: "w-12 h-12 object-cover rounded-lg" %>
                  <% else %>
                    <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center text-2xl">🚗</div>
                  <% end %>
                  <div>
                    <p class="font-bold text-gray-900"><%= c.title.truncate(40) %></p>
                    <p class="text-xs text-gray-500">📍 <%= c.city&.name_ar %></p>
                  </div>
                </div>
              </td>
              <td class="p-4 font-semibold text-gray-700"><%= c.brand %> <%= c.car_model %></td>
              <td class="p-4 text-gray-700"><%= c.year %></td>
              <td class="p-4 font-bold text-gray-900">
                <%= number_with_precision(c.price, precision: 0, delimiter: ",") %>
                <span class="text-xs text-gray-500"><%= c.currency %></span>
              </td>
              <td class="p-4">
                <span class="badge badge-gray"><%= c.status_ar %></span>
              </td>
              <td class="p-4">
                <%= link_to "عرض ←", car_path(c), class: "text-cyan-700 font-bold text-xs hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl p-16 text-center border-2 border-dashed border-gray-200">
      <div class="text-6xl mb-4">🚗</div>
      <p class="text-lg font-bold text-gray-700 mb-2">لا توجد سيارات بعد</p>
      <p class="text-sm text-gray-500 mb-4">ابدأ بإضافة أول سيارة للأسطول</p>
      <%= link_to "➕ إضافة سيارة", new_car_path, class: "btn btn-primary" %>
    </div>
  <% end %>

</div>

