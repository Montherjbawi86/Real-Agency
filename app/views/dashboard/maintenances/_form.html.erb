<%
  in_buildings = current_user.properties.where.not(building_id: nil).includes(:building).group_by(&:building)
  standalone   = current_user.properties.where(building_id: nil)
%>

<%= form_with model: [:dashboard, @maintenance], class: "bg-white p-6 rounded-xl shadow max-w-2xl space-y-4" do |f| %>
  <% if @maintenance.errors.any? %>
    <div class="bg-red-100 p-3 rounded">
      <% @maintenance.errors.full_messages.each do |m| %><p>• <%= m %></p><% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :maintainable_type, "النوع", class: "block mb-1 font-semibold" %>
    <%= f.select :maintainable_type, [["🏠 عقار","Property"],["🚗 سيارة","Car"]], {}, class: "input" %>
  </div>

  <div>
    <%= f.label :maintainable_id, "العنصر", class: "block mb-1 font-semibold" %>
    <select name="maintenance[maintainable_id]" class="input">
      <option value="">— اختر —</option>
      <% in_buildings.each do |building, units| %>
        <optgroup label="🏢 <%= building.name %>">
          <% units.each do |p| %>
            <option value="<%= p.id %>" data-type="Property" <%= "selected" if @maintenance.maintainable_id == p.id %>>
              🚪 <%= p.unit_number.presence || p.title %>
            </option>
          <% end %>
        </optgroup>
      <% end %>
      <% if standalone.any? %>
        <optgroup label="🏘️ عقارات مستقلة">
          <% standalone.each do |p| %>
            <option value="<%= p.id %>" data-type="Property" <%= "selected" if @maintenance.maintainable_id == p.id %>>
              <%= p.title %>
            </option>
          <% end %>
        </optgroup>
      <% end %>
      <% current_user.cars.each do |c| %>
        <option value="<%= c.id %>" data-type="Car" <%= "selected" if @maintenance.maintainable_id == c.id %>>
          🚗 <%= c.brand %> <%= c.car_model %> (<%= c.year %>)
        </option>
      <% end %>
    </select>
  </div>

  <div>
    <%= f.label :title, "العنوان", class: "block mb-1 font-semibold" %>
    <%= f.text_field :title, class: "input" %>
  </div>

  <div>
    <%= f.label :description, "الوصف", class: "block mb-1 font-semibold" %>
    <%= f.text_area :description, rows: 3, class: "input" %>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :kind, "نوع الصيانة", class: "block mb-1 font-semibold" %>
      <%= f.select :kind, [["تغيير زيت","oil_change"],["إطارات","tires"],["فرامل","brakes"],["محرك","engine"],["تكييف","ac_service"],["سباكة","plumbing"],["كهرباء","electrical"],["دهان","painting"],["مصعد","elevator"],["عام","general"]], {}, class: "input" %>
    </div>
    <div>
      <%= f.label :status, "الحالة", class: "block mb-1 font-semibold" %>
      <%= f.select :status, [["مجدولة","scheduled"],["قيد التنفيذ","in_progress"],["مكتملة","completed"]], {}, class: "input" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :cost, "التكلفة", class: "block mb-1 font-semibold" %>
      <%= f.number_field :cost, class: "input" %>
    </div>
    <div>
      <%= f.label :currency, "العملة", class: "block mb-1 font-semibold" %>
      <%= f.select :currency, [["ل.س","SYP"],["$","USD"]], {}, class: "input" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :performed_on, "تاريخ التنفيذ", class: "block mb-1 font-semibold" %>
      <%= f.date_field :performed_on, class: "input", value: @maintenance.performed_on || Date.current %>
    </div>
    <div>
      <%= f.label :next_due_on, "الاستحقاق القادم", class: "block mb-1 font-semibold" %>
      <%= f.date_field :next_due_on, class: "input" %>
    </div>
  </div>

  <div>
    <%= f.label :parts, "القطع المستبدلة", class: "block mb-1 font-semibold" %>
    <%= f.text_area :parts, rows: 2, class: "input" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit "حفظ", class: "btn btn-primary btn-lg" %>
    <%= link_to "إلغاء", dashboard_maintenances_path, class: "btn btn-gray btn-lg" %>
  </div>
<% end %>
