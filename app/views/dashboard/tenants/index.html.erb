<div dir="rtl" class="animate-fade-in">
  <div class="page-header">
    <div>
      <h1 class="page-title">👥 المستأجرون</h1>
      <p class="page-subtitle">إدارة ومتابعة جميع المستأجرين</p>
    </div>
    <%= link_to "➕ إضافة مستأجر", new_dashboard_tenant_path, class: "btn btn-primary" %>
  </div>

  <!-- Quick filter tabs -->
  <div class="filter-tabs">
    <%= link_to dashboard_tenants_path(status: nil),
        class: "filter-tab #{'active' if params[:status].blank? && params[:kind].blank?}" do %>
      الكل <span class="filter-count"><%= @counts[:all] %></span>
    <% end %>
    <%= link_to dashboard_tenants_path(status: "active"),
        class: "filter-tab #{'active' if params[:status] == 'active'}" do %>
      ✅ نشط <span class="filter-count"><%= @counts[:active] %></span>
    <% end %>
    <%= link_to dashboard_tenants_path(status: "inactive"),
        class: "filter-tab #{'active' if params[:status] == 'inactive'}" do %>
      ⏹️ منتهي <span class="filter-count"><%= @counts[:inactive] %></span>
    <% end %>
    <%= link_to dashboard_tenants_path(kind: "rent"),
        class: "filter-tab #{'active' if params[:kind] == 'rent'}" do %>
      🔑 إيجار
    <% end %>
    <%= link_to dashboard_tenants_path(kind: "sale"),
        class: "filter-tab #{'active' if params[:kind] == 'sale'}" do %>
      💰 بيع
    <% end %>
  </div>

  <!-- Search + filters -->
  <div class="filter-card">
    <%= form_with url: dashboard_tenants_path, method: :get, class: "filter-grid", data: { turbo_frame: "tenants_list" } do %>
      <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
      <%= hidden_field_tag :kind,   params[:kind]   if params[:kind].present? %>

      <%= text_field_tag :q, params[:q],
          placeholder: "🔍 بحث بالاسم أو الهاتف أو الرقم الوطني",
          class: "input", style: "grid-column: span 2;" %>

      <%= select_tag :building_id,
          options_from_collection_for_select(@buildings, :id, :name, params[:building_id]),
          include_blank: "🏢 كل الأبنية", class: "input" %>

      <%= select_tag :sort,
          options_for_select([
            ["الأحدث أولاً", "newest"],
            ["الأقدم أولاً", "oldest"],
            ["الاسم (أ-ي)",  "name"],
            ["الإيجار (الأعلى)", "rent_high"],
            ["الإيجار (الأدنى)", "rent_low"]
          ], params[:sort]),
          class: "input" %>

      <div class="flex gap-2">
        <%= submit_tag "🔍 بحث", class: "btn btn-success" %>
        <% if params[:q].present? || params[:building_id].present? || params[:sort].present? %>
          <%= link_to "مسح", dashboard_tenants_path, class: "btn btn-gray" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Results -->
  <%= turbo_frame_tag "tenants_list" do %>
    <% if @tenants.any? %>
      <div class="card overflow-hidden">
        <table class="table-clean">
          <thead>
            <tr>
              <th>الاسم</th>
              <th>الهاتف</th>
              <th>الوحدة / العقار</th>
              <th>نوع العقد</th>
              <th>الإيجار</th>
              <th>المدفوع</th>
              <th>المتبقي</th>
              <th>الحالة</th>
              <th>إجراءات</th>
            </tr>
          </thead>
          <tbody>
            <% @tenants.each do |t| %>
              <tr>
                <td class="font-semibold"><%= t.full_name %></td>
                <td>
                  <a href="tel:<%= t.phone %>" class="text-blue-700 hover:underline"><%= t.phone %></a>
                </td>
                <td>
                  <% if t.property&.building %>
                    <span class="badge badge-blue text-xs">🏢 <%= t.property.building.name %></span>
                    <div class="text-sm">🚪 <%= t.property.unit_number.presence || t.property.title %></div>
                  <% else %>
                    <%= t.property&.title || "—" %>
                  <% end %>
                </td>
                <td>
                  <% kinds = t.contracts.pluck(:kind).uniq %>
                  <% if kinds.include?("rent") %>
                    <span class="badge badge-blue">🔑 إيجار</span>
                  <% end %>
                  <% if kinds.include?("sale") %>
                    <span class="badge badge-purple">💰 بيع</span>
                  <% end %>
                  <% if kinds.empty? %>
                    <span class="badge badge-gray">—</span>
                  <% end %>
                </td>
                <td class="font-bold"><%= number_with_precision(t.rent_amount, precision: 0, delimiter: ",") %> <%= t.currency %></td>
                <td class="font-bold text-green-700"><%= number_with_precision(t.total_paid, precision: 0, delimiter: ",") %></td>
                <td class="font-bold text-red-700"><%= number_with_precision(t.total_pending, precision: 0, delimiter: ",") %></td>
                <td>
                  <span class="badge <%= t.active ? 'badge-green' : 'badge-gray' %>">
                    <%= t.active ? "نشط" : "منتهي" %>
                  </span>
                </td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    <%= link_to "تعديل", edit_dashboard_tenant_path(t), class: "btn btn-warning btn-sm" %>
                    <%= button_to t.active ? "إنهاء" : "تنشيط", toggle_active_dashboard_tenant_path(t),
                        method: :patch,
                        class: "btn btn-gray btn-sm" %>
                    <%= link_to "دفعات", dashboard_payments_path(tenant_id: t.id), class: "btn btn-primary btn-sm" %>
                    <%= button_to "حذف", dashboard_tenant_path(t),
                        method: :delete,
                        data: { turbo_confirm: "متأكد؟" },
                        class: "btn btn-danger btn-sm" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <p class="text-sm text-black mt-3">
        عرض <%= @tenants.size %> مستأجر
        <% if params[:q].present? %> لـ "<strong><%= params[:q] %></strong>"<% end %>
      </p>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">👥</div>
        <h3 class="empty-title">لا توجد نتائج</h3>
        <p class="empty-sub">جرب تعديل البحث أو الفلاتر</p>
        <div class="mt-4">
          <%= link_to "➕ إضافة مستأجر", new_dashboard_tenant_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
