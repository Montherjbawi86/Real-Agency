<%
  # Group properties: first those inside buildings, then standalone
  in_buildings = current_user.properties.where.not(building_id: nil)
                                .includes(:building)
                                .group_by(&:building)
  standalone   = current_user.properties.where(building_id: nil)
%>

<%= form_with model: [:dashboard, @tenant], class: "bg-white p-6 rounded-xl shadow max-w-2xl space-y-4" do |f| %>
  <% if @tenant.errors.any? %>
    <div class="bg-red-100 p-3 rounded">
      <% @tenant.errors.full_messages.each do |m| %><p>• <%= m %></p><% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :full_name, "الاسم الكامل", class: "block mb-1 font-semibold" %>
      <%= f.text_field :full_name, class: "input", required: true %>
    </div>
    <div>
      <%= f.label :phone, "الهاتف", class: "block mb-1 font-semibold" %>
      <%= f.text_field :phone, class: "input", required: true, placeholder: "09xxxxxxxx" %>
    </div>
  </div>

  <div>
    <%= f.label :national_id, "الرقم الوطني", class: "block mb-1 font-semibold" %>
    <%= f.text_field :national_id, class: "input" %>
  </div>

  <div>
    <%= f.label :property_id, "🏠 العقار / الوحدة", class: "block mb-1 font-semibold" %>
    <select name="tenant[property_id]" class="input">
      <option value="">— اختر —</option>
      <% in_buildings.each do |building, units| %>
        <optgroup label="🏢 <%= building.name %>">
          <% units.each do |p| %>
            <option value="<%= p.id %>" <%= "selected" if @tenant.property_id == p.id %>>
              🚪 وحدة <%= p.unit_number %> — <%= p.property_type_ar %> (<%= p.size %> م²)
            </option>
          <% end %>
        </optgroup>
      <% end %>
      <% if standalone.any? %>
        <optgroup label="🏘️ عقارات مستقلة">
          <% standalone.each do |p| %>
            <option value="<%= p.id %>" <%= "selected" if @tenant.property_id == p.id %>>
              <%= p.title %> — <%= p.city.name_ar %>
            </option>
          <% end %>
        </optgroup>
      <% end %>
    </select>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :start_date, "من تاريخ", class: "block mb-1 font-semibold" %>
      <%= f.date_field :start_date, class: "input" %>
    </div>
    <div>
      <%= f.label :end_date, "إلى تاريخ", class: "block mb-1 font-semibold" %>
      <%= f.date_field :end_date, class: "input" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :rent_amount, "قيمة الإيجار", class: "block mb-1 font-semibold" %>
      <%= f.number_field :rent_amount, class: "input" %>
    </div>
    <div>
      <%= f.label :currency, "العملة", class: "block mb-1 font-semibold" %>
      <%= f.select :currency, [["ل.س","SYP"],["$","USD"]], {}, class: "input" %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, "نشط" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit "حفظ", class: "btn btn-primary btn-lg" %>
    <%= link_to "إلغاء", dashboard_tenants_path, class: "btn btn-gray btn-lg" %>
  </div>
<% end %>
