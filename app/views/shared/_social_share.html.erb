<%
  # locals: url (full URL), text (share text), title (optional), compact (bool)
  compact = local_assigns.fetch(:compact, false)
  encoded_url  = ERB::Util.url_encode(url)
  encoded_text = ERB::Util.url_encode(text)
%>

<div class="<%= compact ? 'flex gap-2' : 'flex flex-wrap gap-2' %>" dir="rtl">

  <!-- Facebook -->
  <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encoded_url %>"
     target="_blank" rel="noopener"
     class="social-btn social-facebook"
     title="شارك على فيسبوك">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.5-4.5-10-10-10S2 6.5 2 12c0 5 3.7 9.1 8.4 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7C18.3 21.1 22 17 22 12z"/></svg>
    <% unless compact %><span>فيسبوك</span><% end %>
  </a>

  <!-- WhatsApp -->
  <a href="https://wa.me/?text=<%= encoded_text %>%20<%= encoded_url %>"
     target="_blank" rel="noopener"
     class="social-btn social-whatsapp"
     title="شارك على واتساب">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5C18.3 1.3 15.3 0 12 0 5.4 0 0 5.4 0 12c0 2.1.6 4.2 1.6 6L0 24l6.2-1.6c1.7.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12 0-3.2-1.3-6.2-3.5-8.3zM12 21.9c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-3.7 1 1-3.6-.2-.4c-1-1.6-1.5-3.4-1.5-5.3 0-5.5 4.5-10 10-10 2.7 0 5.2 1 7.1 2.9 1.9 1.9 2.9 4.4 2.9 7.1-.1 5.5-4.6 9.9-10.1 9.9zm5.5-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.6-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.2.2 2 3.1 5 4.3.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg>
    <% unless compact %><span>واتساب</span><% end %>
  </a>

  <!-- Telegram -->
  <a href="https://t.me/share/url?url=<%= encoded_url %>&text=<%= encoded_text %>"
     target="_blank" rel="noopener"
     class="social-btn social-telegram"
     title="شارك على تيليجرام">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9.8 15.5l-.4 4.8c.5 0 .8-.2 1.1-.5l2.6-2.5 5.4 3.9c1 .6 1.7.3 2-.9l3.6-16.8c.3-1.5-.5-2.1-1.5-1.7L1.3 10.2C-.2 10.8-.2 11.7 1 12.1l4.9 1.5L17.2 6c.5-.4 1-.2.6.2z"/></svg>
    <% unless compact %><span>تيليجرام</span><% end %>
  </a>

  <!-- Twitter / X -->
  <a href="https://twitter.com/intent/tweet?text=<%= encoded_text %>&url=<%= encoded_url %>"
     target="_blank" rel="noopener"
     class="social-btn social-x"
     title="شارك على X">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.3 8.3L23 22h-6.8l-5.3-7-6.1 7H1.7l7.7-8.8L1 2h6.9l4.8 6.3L18.9 2zm-2.4 18h1.9L7.6 4H5.6l10.9 16z"/></svg>
    <% unless compact %><span>X</span><% end %>
  </a>

  <!-- Instagram (copy link — Instagram doesn't support direct share) -->
  <button type="button"
          data-share-copy="<%= url %>"
          onclick="navigator.clipboard.writeText(this.dataset.shareCopy); this.querySelector('.label').textContent='✓ تم النسخ'; setTimeout(()=>this.querySelector('.label').textContent='إنستغرام', 2000);"
          class="social-btn social-instagram"
          title="انسخ الرابط لإنستغرام">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.9.9 1.4.2.4.4 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.9.7-1.4.9-.4.2-1 .4-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.9-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.2-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.9-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.2-.1 1.6-.1 4.8-.1zM12 0C8.7 0 8.3 0 7.1.1 5.8.2 5 .3 4.2.6c-.9.3-1.6.8-2.3 1.5-.7.7-1.1 1.5-1.5 2.3-.3.8-.4 1.7-.4 2.9C0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.2.2 2 .5 2.8.3.9.8 1.6 1.5 2.3.7.7 1.4 1.1 2.3 1.5.8.3 1.6.4 2.9.4 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c1.2-.1 2-.2 2.8-.5.9-.3 1.6-.8 2.3-1.5.7-.7 1.1-1.4 1.5-2.3.3-.8.4-1.6.4-2.9.1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.1-1.2-.2-2-.5-2.8-.3-.9-.8-1.6-1.5-2.3-.7-.7-1.4-1.1-2.3-1.5-.8-.3-1.6-.4-2.9-.4C15.7 0 15.3 0 12 0zm0 5.8c-3.4 0-6.2 2.8-6.2 6.2s2.8 6.2 6.2 6.2 6.2-2.8 6.2-6.2S15.4 5.8 12 5.8zm0 10.2c-2.2 0-4-1.8-4-4s1.8-4 4-4 4 1.8 4 4-1.8 4-4 4zm6.4-10.4c-.8 0-1.4-.6-1.4-1.4s.6-1.4 1.4-1.4 1.4.6 1.4 1.4-.6 1.4-1.4 1.4z"/></svg>
    <span class="label"><% unless compact %>إنستغرام<% end %></span>
  </button>

  <!-- TikTok (copy link) -->
  <button type="button"
          data-share-copy="<%= url %>"
          onclick="navigator.clipboard.writeText(this.dataset.shareCopy); this.querySelector('.label').textContent='✓ تم النسخ'; setTimeout(()=>this.querySelector('.label').textContent='تيك توك', 2000);"
          class="social-btn social-tiktok"
          title="انسخ الرابط لتيك توك">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 6.7c-1.5-.9-2.5-2.6-2.5-4.5 0-.3 0-.5.1-.8h-3.9v13.8c0 1.9-1.5 3.5-3.5 3.5-1.9 0-3.5-1.5-3.5-3.5s1.5-3.5 3.5-3.5c.4 0 .7.1 1 .2V8c-.3 0-.6-.1-1-.1-4 0-7.3 3.3-7.3 7.3s3.3 7.3 7.3 7.3 7.3-3.3 7.3-7.3V9c1.2.9 2.6 1.4 4.2 1.4V6.5c-.6 0-1.2-.1-1.7-.3z"/></svg>
    <span class="label"><% unless compact %>تيك توك<% end %></span>
  </button>

  <!-- Copy link -->
  <button type="button"
          data-share-copy="<%= url %>"
          onclick="navigator.clipboard.writeText(this.dataset.shareCopy); this.querySelector('.label').textContent='✓ تم'; setTimeout(()=>this.querySelector('.label').textContent='نسخ الرابط', 2000);"
          class="social-btn social-copy"
          title="انسخ الرابط">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
    <span class="label"><% unless compact %>نسخ الرابط<% end %></span>
  </button>

</div>
