<div dir="rtl" class="admin-page">
  <div class="page-header">
    <h1 class="page-title">✏️ تعديل الوكالة</h1>
    <%= link_to "← رجوع", admin_agency_path(@agency), class: "btn btn-gray" %>
  </div>

  <%= form_with model: [:admin, @agency], class: "bg-white p-6 rounded-xl shadow space-y-4" do |f| %>
    <% if @agency.errors.any? %>
      <div class="bg-red-100 p-3 rounded">
        <% @agency.errors.full_messages.each do |m| %><p>• <%= m %></p><% end %>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :name, "اسم الوكالة", class: "block mb-1 font-semibold" %>
        <%= f.text_field :name, class: "input" %>
      </div>
      <div>
        <%= f.label :kind, "النوع", class: "block mb-1 font-semibold" %>
        <%= f.select :kind, [["🏘️ عقارات","property"],["🚗 سيارات","car"]], {}, class: "input" %>
      </div>
      <div>
        <%= f.label :phone, "الهاتف", class: "block mb-1 font-semibold" %>
        <%= f.text_field :phone, class: "input" %>
      </div>
      <div>
        <%= f.label :whatsapp, "واتساب", class: "block mb-1 font-semibold" %>
        <%= f.text_field :whatsapp, class: "input" %>
      </div>
      <div>
        <%= f.label :email, "البريد", class: "block mb-1 font-semibold" %>
        <%= f.email_field :email, class: "input" %>
      </div>
      <div>
        <%= f.label :city_id, "المدينة", class: "block mb-1 font-semibold" %>
        <%= f.collection_select :city_id, City.order(:name_ar), :id, :name_ar, {}, class: "input" %>
      </div>
    </div>

    <div>
      <%= f.label :address, "العنوان", class: "block mb-1 font-semibold" %>
      <%= f.text_field :address, class: "input" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :tax_number, "الرقم الضريبي", class: "block mb-1 font-semibold" %>
        <%= f.text_field :tax_number, class: "input" %>
      </div>
      <div>
        <%= f.label :commercial_registry, "السجل التجاري", class: "block mb-1 font-semibold" %>
        <%= f.text_field :commercial_registry, class: "input" %>
      </div>
    </div>

    <div>
      <%= f.label :description, "الوصف", class: "block mb-1 font-semibold" %>
      <%= f.text_area :description, rows: 3, class: "input" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :approval_status, "حالة الموافقة", class: "block mb-1 font-semibold" %>
        <%= f.select :approval_status,
            [["⏳ بانتظار","pending"],["✅ موافق","approved"],["❌ مرفوض","rejected"],["⏸️ موقوف","suspended"]],
            {}, class: "input" %>
      </div>
      <div class="flex items-center gap-2 pt-6">
        <%= f.check_box :verified %>
        <%= f.label :verified, "✅ موثّق" %>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit "💾 حفظ", class: "btn btn-primary btn-lg" %>
      <%= link_to "إلغاء", admin_agency_path(@agency), class: "btn btn-gray btn-lg" %>
    </div>
  <% end %>
</div>
