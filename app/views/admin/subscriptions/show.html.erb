<div dir="rtl" class="max-w-3xl mx-auto">
  <div class="page-header">
    <h1 class="page-title">📋 اشتراك #<%= @subscription.id %></h1>
    <%= link_to "← رجوع", admin_subscriptions_path, class: "btn btn-gray" %>
  </div>

  <div class="report-info-grid mb-6">
    <div class="report-info-card">
      <h4 class="report-info-title">👤 المستخدم</h4>
      <p class="font-bold"><%= @subscription.user.display_name %></p>
    </div>
    <div class="report-info-card">
      <h4 class="report-info-title">💳 الخطة</h4>
      <p class="font-bold"><%= @subscription.plan.name_ar %></p>
    </div>
    <div class="report-info-card">
      <h4 class="report-info-title">📌 الحالة</h4>
      <p><span class="badge <%= @subscription.status_badge_class %>"><%= @subscription.status_ar %></span></p>
    </div>
    <div class="report-info-card">
      <h4 class="report-info-title">📅 البداية</h4>
      <p class="font-bold"><%= @subscription.starts_on || "—" %></p>
    </div>
    <div class="report-info-card">
      <h4 class="report-info-title">📅 الانتهاء</h4>
      <p class="font-bold"><%= @subscription.ends_on || "—" %></p>
    </div>
  </div>

  <div class="card p-4 flex gap-3">
    <%= button_to "✅ تنشيط", activate_admin_subscription_path(@subscription), method: :patch, class: "btn btn-success" %>
    <%= button_to "❌ إلغاء", cancel_admin_subscription_path(@subscription), method: :patch, class: "btn btn-danger", data: { turbo_confirm: "متأكد؟" } %>
  </div>
</div>
