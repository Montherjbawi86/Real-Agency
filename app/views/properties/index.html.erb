<div dir="rtl" class="container-page">
  <div class="page-header">
    <div>
      <h1 class="page-title">🏘️ العقارات المتاحة</h1>
      <p class="page-subtitle">اكتشف أفضل العقارات في سوريا</p>
    </div>
    <% if user_signed_in? && current_user.property_agent? %>
      <%= link_to "➕ أضف عقاراً", new_property_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="filter-card">
    <%= form_with url: properties_path, method: :get, class: "space-y-4" do %>

      <!-- Search text -->
      <div>
        <%= text_field_tag :q, params[:q], placeholder: "🔍 بحث بالعنوان أو الوصف أو العنوان التفصيلي", class: "input" %>
      </div>

      <!-- Primary filters -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
        <%= select_tag :city_id,
            options_from_collection_for_select(@cities, :id, :name_ar, params[:city_id]),
            include_blank: "🏙️ كل المدن", class: "input" %>

        <%= select_tag :type,
            options_for_select([
              ["🏢 شقة","apartment"],["🏡 فيلا","villa"],["🌍 أرض","land"],
              ["🏪 محل تجاري","shop"],["🏬 مكتب","office"],["🏨 بناء","building"],
              ["📦 مستودع","warehouse"],["🌾 مزرعة","farm"]
            ], params[:type]),
            include_blank: "🏠 كل الأنواع", class: "input" %>

        <%= select_tag :listing,
            options_for_select([["💰 للبيع","sale"],["🔑 للإيجار","rent"]], params[:listing]),
            include_blank: "📋 بيع / إيجار", class: "input" %>

        <%= select_tag :sort,
            options_for_select([
              ["الأحدث أولاً", "newest"],
              ["الأقدم أولاً", "oldest"],
              ["السعر: الأقل → الأعلى", "price_asc"],
              ["السعر: الأعلى → الأقل", "price_desc"],
              ["المساحة: الأقل → الأعلى", "size_asc"],
              ["المساحة: الأعلى → الأقل", "size_desc"]
            ], params[:sort]),
            class: "input" %>
      </div>

      <!-- Advanced filters -->
      <details class="border border-gray-200 rounded-lg p-3">
        <summary class="cursor-pointer font-bold text-black">⚙️ فلاتر متقدمة</summary>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3">

          <div>
            <label class="text-xs font-semibold text-black">💰 السعر من</label>
            <%= number_field_tag :min_price, params[:min_price], placeholder: "أدنى سعر", class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">💰 السعر إلى</label>
            <%= number_field_tag :max_price, params[:max_price], placeholder: "أعلى سعر", class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">💱 العملة</label>
            <%= select_tag :currency,
                options_for_select([["ل.س","SYP"],["$","USD"]], params[:currency]),
                include_blank: "الكل", class: "input" %>
          </div>

          <div>
            <label class="text-xs font-semibold text-black">📐 المساحة من (م²)</label>
            <%= number_field_tag :min_size, params[:min_size], class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">📐 المساحة إلى (م²)</label>
            <%= number_field_tag :max_size, params[:max_size], class: "input" %>
          </div>
          <div>
            <label class="text-xs font-semibold text-black">🛏️ غرف النوم</label>
            <%= number_field_tag :min_rooms, params[:min_rooms], placeholder: "الحد الأدنى", class: "input" %>
          </div>

          <div>
            <label class="text-xs font-semibold text-black">🚿 الحمامات</label>
            <%= number_field_tag :min_bathrooms, params[:min_bathrooms], placeholder: "الحد الأدنى", class: "input" %>
          </div>

          <div class="md:col-span-2">
            <label class="text-xs font-semibold text-black">✨ المزايا</label>
            <div class="flex flex-wrap gap-3 mt-1">
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_elevator, "1", params[:has_elevator] == "1" %> مصعد</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_parking, "1", params[:has_parking] == "1" %> موقف</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :furnished, "1", params[:furnished] == "1" %> مفروش</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_pool, "1", params[:has_pool] == "1" %> مسبح</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_garden, "1", params[:has_garden] == "1" %> حديقة</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_solar_energy, "1", params[:has_solar_energy] == "1" %> طاقة شمسية</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_generator, "1", params[:has_generator] == "1" %> مولّد</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_central_heating, "1", params[:has_central_heating] == "1" %> تدفئة مركزية</label>
              <label class="flex items-center gap-1 text-sm"><%= check_box_tag :has_ac, "1", params[:has_ac] == "1" %> تكييف</label>
            </div>
          </div>
        </div>
      </details>

      <div class="flex gap-2">
        <%= submit_tag "🔍 بحث", class: "btn btn-primary" %>
        <%= link_to "🔄 إعادة تعيين", properties_path, class: "btn btn-gray" %>
      </div>
    <% end %>
  </div>

  <p class="text-sm text-black mb-3">
    النتائج: <strong><%= @properties.count %></strong> عقار
  </p>

  <% if @properties.any? %>
    <div class="listings-grid">
      <% @properties.each_with_index do |p, i| %>
        <div class="listing-card animate-fade-in" style="animation-delay:<%= i*40 %>ms;">
          <div class="listing-image-wrap">
            <% if p.cover_image.attached? %>
              <%= image_tag p.cover_image, class: "listing-image" %>
            <% else %>
              <div class="listing-image-placeholder">🏠</div>
            <% end %>
            <div class="listing-badges-tr">
              <span class="badge <%= p.sale? ? 'badge-purple' : 'badge-blue' %>">
                <%= p.sale? ? "💰 للبيع" : "🔑 للإيجار" %>
              </span>
              <span class="badge badge-gray"><%= p.property_type_ar %></span>
            </div>
            <div class="listing-price-badge">
              <span class="listing-price-value"><%= number_with_precision(p.price, precision: 0, delimiter: ",") %></span>
              <span class="listing-price-currency"><%= p.currency %></span>
            </div>
          </div>
          <div class="listing-body">
            <h3 class="listing-title"><%= link_to p.title, property_path(p) %></h3>
            <p class="listing-sub">📍 <%= p.city.name_ar %></p>
            <div class="listing-features">
              <% if p.size %><span>📐 <%= p.size %> م²</span><% end %>
              <% if p.rooms.to_i > 0 %><span>🛏️ <%= p.rooms %></span><% end %>
              <% if p.bathrooms.to_i > 0 %><span>🚿 <%= p.bathrooms %></span><% end %>
            </div>
            <div class="listing-footer">
              <%= link_to "التفاصيل ←", property_path(p), class: "btn btn-outline btn-sm" %>
              <span class="text-xs text-black"><%= time_ago_in_words(p.created_at) %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-icon">🔍</div>
      <h3 class="empty-title">لا توجد نتائج</h3>
      <p class="empty-sub">جرب تعديل الفلاتر</p>
    </div>
  <% end %>
</div>
