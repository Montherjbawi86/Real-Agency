<%= form_with model: @property, class: "space-y-4 bg-white p-6 rounded-xl shadow max-w-3xl" do |f| %>
  <% if @property.errors.any? %>
    <div class="bg-red-100 p-3 rounded">
      <% @property.errors.full_messages.each do |m| %><p>• <%= m %></p><% end %>
    </div>
  <% end %>

  <!-- Building selection (optional) -->
  <% if current_user.buildings.any? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <h3 class="font-bold text-blue-900 mb-3">🏢 هل هذه الوحدة داخل بناء؟</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <%= f.label :building_id, "البناء", class: "block mb-1 font-semibold text-sm" %>
          <%= f.collection_select :building_id,
              current_user.buildings.order(:name),
              :id, :name,
              { include_blank: "— بدون بناء —" },
              class: "input" %>
        </div>
        <div>
          <%= f.label :unit_number, "رقم الوحدة", class: "block mb-1 font-semibold text-sm" %>
          <%= f.text_field :unit_number, class: "input", placeholder: "101، A12، محل G1..." %>
        </div>
      </div>
      <p class="text-xs text-blue-800 mt-2">
        💡 اتركه فارغاً إذا كانت الوحدة مستقلة (ليست داخل بناء)
      </p>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "📝 عنوان الإعلان", class: "block mb-1 font-semibold" %>
    <%= f.text_field :title, class: "input", required: true %>
  </div>

  <div>
    <%= f.label :description, "📄 الوصف", class: "block mb-1 font-semibold" %>
    <%= f.text_area :description, rows: 4, class: "input", required: true %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :property_type, "🏠 نوع العقار", class: "block mb-1 font-semibold" %>
      <%= f.select :property_type,
          [["🏢 شقة","apartment"],["🏡 فيلا","villa"],["🌍 أرض","land"],
           ["🏪 محل تجاري","shop"],["🏬 مكتب","office"],["🏨 بناء","building_unit"],
           ["📦 مستودع","warehouse"],["🌾 مزرعة","farm"]],
          {}, class: "input" %>
    </div>
    <div>
      <%= f.label :listing_type, "🏷️ نوع العرض", class: "block mb-1 font-semibold" %>
      <%= f.select :listing_type, [["💰 للبيع","sale"],["🔑 للإيجار","rent"]], {}, class: "input" %>
    </div>

    <div>
      <%= f.label :city_id, "🏙️ المدينة", class: "block mb-1 font-semibold" %>
      <%= f.collection_select :city_id, City.order(:name_ar), :id, :name_ar, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :price, "💰 السعر", class: "block mb-1 font-semibold" %>
      <div class="flex gap-2">
        <%= f.number_field :price, class: "input", required: true %>
        <%= f.select :currency, [["ل.س","SYP"],["$","USD"]], {}, class: "input", style: "max-width:100px;" %>
      </div>
    </div>

    <div>
      <%= f.label :size, "📐 المساحة (م²)", class: "block mb-1 font-semibold" %>
      <%= f.number_field :size, class: "input", required: true %>
    </div>
    <div>
      <%= f.label :address, "📍 العنوان التفصيلي", class: "block mb-1 font-semibold" %>
      <%= f.text_field :address, class: "input" %>
    </div>

    <div>
      <%= f.label :floor, "🏗️ الطابق", class: "block mb-1 font-semibold" %>
      <%= f.number_field :floor, class: "input" %>
    </div>
    <div>
      <%= f.label :total_floors, "🏢 عدد الطوابق", class: "block mb-1 font-semibold" %>
      <%= f.number_field :total_floors, class: "input" %>
    </div>

    <div>
      <%= f.label :rooms, "🛏️ غرف النوم", class: "block mb-1 font-semibold" %>
      <%= f.number_field :rooms, class: "input" %>
    </div>
    <div>
      <%= f.label :bathrooms, "🚿 الحمامات", class: "block mb-1 font-semibold" %>
      <%= f.number_field :bathrooms, class: "input" %>
    </div>
  </div>

  <fieldset class="border border-gray-200 p-4 rounded-lg">
    <legend class="font-bold px-2">✨ المزايا</legend>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
      <% Property::AMENITIES.each do |field, label| %>
        <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 p-1 rounded">
          <%= f.check_box field %>
          <span><%= label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div>
    <%= f.label :youtube_url, "🎥 رابط فيديو يوتيوب (اختياري)", class: "block mb-1 font-semibold" %>
    <%= f.url_field :youtube_url,
        class: "input",
        placeholder: "https://www.youtube.com/watch?v=..." %>
    <p class="text-xs text-black mt-1">
      💡 الصق رابط يوتيوب وسيظهر الفيديو داخل صفحة العقار.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :cover_image, "🖼️ صورة الغلاف", class: "block mb-1 font-semibold" %>
      <%= f.file_field :cover_image, class: "input" %>
    </div>
    <div>
      <%= f.label :images, "🖼️ صور إضافية", class: "block mb-1 font-semibold" %>
      <%= f.file_field :images, multiple: true, class: "input" %>
    </div>
  </div>

  <% if current_user.agent? && !current_user.current_plan&.unlimited? %>
    <div class="alert-info text-sm">
      💡 <strong>متبقٍ لك:</strong> <%= current_user.listings_remaining %> إعلان في خطة <%= current_user.current_plan&.name_ar %>
      <% if current_user.listings_remaining.to_i <= 3 %>
        — <strong>على وشك النفاد</strong>
        <%= link_to "ترقية الآن ←", billing_plans_path, class: "text-blue-700 underline font-bold" %>
      <% end %>
    </div>
  <% end %>

  <div class="flex gap-3">
    <%= f.submit "💾 حفظ العقار", class: "btn btn-primary btn-lg" %>
    <%= link_to "إلغاء", properties_path, class: "btn btn-gray btn-lg" %>
  </div>
<% end %>
