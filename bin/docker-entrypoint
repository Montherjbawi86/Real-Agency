#!/usr/bin/env bash
set -e

rm -f /rails/tmp/pids/server.pid

# Prepare database (runs migrations)
bin/rails db:prepare

# Create/update admin if env vars set
if [ -n "$ADMIN_EMAIL" ] && [ -n "$ADMIN_PASSWORD" ]; then
  echo "==> Creating admin user..."
  bin/rails admin:create || true
fi

exec "$@"
